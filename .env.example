# Copia este archivo a .env y ajusta las URLs. Después reinicia con: npm run start:clear
# Android Emulator  -> http://10.0.2.2:3001 / 3002 / 3003
# iOS Simulator     -> http://localhost:3001 / 3002 / 3003
# Celular físico    -> http://IP_DE_TU_PC:3001 / 3002 / 3003   (misma red Wi-Fi)
# Producción        -> https://auth-xxx.up.railway.app, etc. (HTTPS obligatorio en builds de producción)
EXPO_PUBLIC_AUTH_URL=http://192.168.1.20:3001
EXPO_PUBLIC_PRODUCTOS_URL=http://192.168.1.20:3002
EXPO_PUBLIC_COMPRAS_URL=http://192.168.1.20:3003
