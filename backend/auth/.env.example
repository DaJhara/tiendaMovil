PORT=3001
# PostgreSQL en la nube (Railway/Neon/Supabase...). Debe ser la MISMA base para los 3 servicios.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Debe ser IDÉNTICO en auth, productos y compras
JWT_SECRET=cambia-esta-clave-larga-y-aleatoria
JWT_EXPIRES_IN=7d
# Orígenes CORS separados por coma (vacío = cualquiera). En producción pon tus dominios.
CORS_ORIGIN=
# Crea el usuario demo@tienda.com / 123456 al arrancar (pon false en producción real)
SEED_DEMO_USER=true
